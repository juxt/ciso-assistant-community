# Demo environment variables consumed by docker-compose.override.yml.
# Copy this file to `.env` (which is gitignored) and fill in real values.

# Anthropic API key for the LiteLLM proxy.
# Generate at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Initial Django superuser created automatically on first backend boot
# (see backend/startup.sh). Used to log in at https://localhost:8443.
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
